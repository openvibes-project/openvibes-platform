[Unit]
Description=OpenVIBES rule distribution service
Documentation=https://github.com/openvibes-project/openvibes-platform
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=openvibes_distribution
Group=openvibes_distribution
ExecStart=/usr/bin/openvibes-distribution --config /etc/openvibes/distribution.toml
# On SIGINT distribution stops accepting and drains requests in flight
# (bounded by request_timeout_seconds) before exiting.
KillSignal=SIGINT
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
