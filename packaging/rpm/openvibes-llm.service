# The local model server for the console's assistant (assistant spec §3
# options A and B, §6): llama.cpp's llama-server from a pinned build, on
# loopback only, as its own user, with nowhere to go if it is compromised.
# Settings: /etc/openvibes/llm.conf; the model: /var/lib/openvibes-llm/
# model.conf, written by `openvibes-admin assistant model install`. Memory and
# CPU share: `systemctl edit openvibes-llm` (MemoryMax=, CPUWeight=).
# Started on demand: openvibes-llm.socket (the public port) starts
# openvibes-llm-proxy.service, which requires this; when the proxy exits
# after OPENVIBES_LLM_IDLE without a request, this stops too (the model's
# memory is freed). Enable the socket, not this unit.
[Unit]
Description=OpenVIBES local model server (assistant)
Documentation=https://github.com/openvibes-project/openvibes-platform
After=network.target
StopWhenUnneeded=yes
PartOf=openvibes-llm.socket

[Service]
Type=exec
User=openvibes-llm
Group=openvibes-llm
EnvironmentFile=/etc/openvibes/llm.conf
# Written by `sudo openvibes-admin helper assistant-tune`; overrides llm.conf
# for OPENVIBES_LLM_THREADS and OPENVIBES_LLM_GPU_LAYERS. After changing either
# in llm.conf, rerun it (it keeps your value and drops it from here) and
# restart; or delete tuning.conf. To keep a value equal to the packaged
# default (THREADS=4), pin it: `systemctl edit openvibes-llm`, add
# `EnvironmentFile=/etc/openvibes/llm-pin.conf`; a drop-in's file is read
# after these, so it wins.
EnvironmentFile=-/var/lib/openvibes-llm/tuning.conf
# Optional so that, before the first model install, the check says what to do.
EnvironmentFile=-/var/lib/openvibes-llm/model.conf
# No crash backtrace: ggml would start gdb for it.
Environment=GGML_NO_BACKTRACE=1
# The API key the console sends; the file stays root's (or the console's).
LoadCredential=api-key:/etc/openvibes/llm-api-key
# Refuses unknown llama-server variables, out-of-range settings, and a model
# file that is writable, outside the models directory, or not the one whose
# SHA-256 llm.conf pins.
ExecStartPre=/usr/libexec/openvibes-llm/openvibes-llm-check
# Every option is fixed here; nothing reaches llama-server from requests but
# the chat API the console calls. Left off by default and not enabled:
# web UI, props changes, metrics, tools/MCP, media paths, model downloads.
ExecStart=/usr/libexec/openvibes-llm/llama-server \
    --model ${OPENVIBES_LLM_MODEL} --alias ${OPENVIBES_LLM_ALIAS} \
    --host /run/openvibes-llm/llama.sock \
    --ctx-size ${OPENVIBES_LLM_CONTEXT} --threads ${OPENVIBES_LLM_THREADS} \
    --n-gpu-layers ${OPENVIBES_LLM_GPU_LAYERS} --parallel ${OPENVIBES_LLM_PARALLEL} \
    --api-key-file %d/api-key \
    --no-webui --no-slots --offline --jinja --reasoning off --timeout 300 --log-colors off
# Behind the proxy on a Unix socket, not a TCP port: a port is free while
# the server is stopped and any local user could bind it. The directory is
# 0750 openvibes-llm (the proxy runs as this account too), the socket 0700
# (UMask=). It is removed whenever the service stops, crash included, so a
# stale socket never blocks the next start.
RuntimeDirectory=openvibes-llm
RuntimeDirectoryMode=0750
# Active only once the model is loaded: the proxy (After= this) then passes
# the waiting connection on. Never --sleep-idle-seconds (CVE-2026-43631):
# idle unloading stops the whole process instead.
ExecStartPost=/usr/libexec/openvibes-llm/openvibes-llm-check --wait-ready /run/openvibes-llm/llama.sock
# The check hashes the model, then --wait-ready allows 180 s for loading.
TimeoutStartSec=300
# The next request starts it again; restarting on its own would reload
# 5.4 GB after an out-of-memory kill or re-hash in a loop on a bad model.
Restart=no
# Resource shares: the model must never starve ingest or PostgreSQL.
MemoryMax=8G
CPUWeight=20
IOWeight=20
TasksMax=512
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Only the two binaries (and the libraries they load) can be executed: no
# shell, no gdb, nothing a hijacked process could start.
NoExecPaths=/
ExecPaths=/usr/libexec/openvibes-llm /usr/lib64 /usr/lib
# No network at all: the Unix socket is its only way in.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
