# Passes connections from openvibes-llm.socket to llama-server's Unix socket
# and exits after OPENVIBES_LLM_IDLE without one;
# openvibes-llm.service (StopWhenUnneeded=yes) then stops and the model is
# unloaded. Not llama-server's --sleep-idle-seconds: CVE-2026-43631.
[Unit]
Description=OpenVIBES local model server proxy (assistant)
Documentation=https://github.com/openvibes-project/openvibes-platform
Requires=openvibes-llm.service
After=openvibes-llm.service
# Restarted with the socket: a running proxy would otherwise keep the
# socket from restarting ("already active, refusing").
PartOf=openvibes-llm.socket

[Service]
Type=exec
# The default for an llm.conf from before idle unloading; llm.conf overrides.
Environment=OPENVIBES_LLM_IDLE=5min
EnvironmentFile=/etc/openvibes/llm.conf
# Refuses a malformed idle time.
ExecStartPre=/usr/libexec/openvibes-llm/openvibes-llm-check --idle-only
ExecStart=/usr/lib/systemd/systemd-socket-proxyd \
    --exit-idle-time=${OPENVIBES_LLM_IDLE} /run/openvibes-llm/llama.sock
# The server's account: only it (and root) can enter /run/openvibes-llm.
User=openvibes-llm
Group=openvibes-llm
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Accepts on the socket unit's loopback port; connects only to the Unix socket.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
TasksMax=64
