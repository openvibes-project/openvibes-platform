[Unit]
Description=OpenVIBES vulnerability feeds and matching
Documentation=https://github.com/openvibes-project/openvibes-platform
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=openvibes_vulns
Group=openvibes_vulns
ExecStart=/usr/bin/openvibes-vulns --config /etc/openvibes/vulns.toml
# OSV downloads (up to ~760 MB for Ubuntu) land here and are removed after
# import; the rest of the file system stays read-only (ProtectSystem=strict).
StateDirectory=openvibes-vulns
StateDirectoryMode=0700
# On SIGINT the service stops; an interrupted check is simply redone
KillSignal=SIGINT
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
