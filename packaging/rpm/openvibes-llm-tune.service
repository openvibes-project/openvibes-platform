[Unit]
Description=OpenVIBES assistant model switch and tuning after an upgrade
Documentation=https://github.com/openvibes-project/openvibes-platform

[Service]
Type=oneshot
# Started by the package after an install or upgrade (no [Install]). First
# switches a host on an earlier pinned model to model.pin's (#264: waits for
# openvibes-llm-model-fetch.service, the download), then tunes the model
# if the host is not tuned yet. Does nothing otherwise; one log line; never
# fails the package transaction.
ExecStart=/usr/bin/openvibes-admin helper assistant-tune --auto
# The download (up to 2 h) and the timed call (up to 180 s after a health
# wait of up to 120 s).
TimeoutStartSec=2h15min
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/openvibes-llm /etc/openvibes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Root, but only to read root's key, write files owned by other accounts
# and talk to systemd.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
