[Unit]
Description=OpenVIBES additive schema migrations before the services start
Documentation=https://github.com/openvibes-project/openvibes-platform
After=postgresql.service
# Before Setup there is no database to migrate.
ConditionPathExists=/etc/openvibes/setup.toml

[Service]
Type=oneshot
User=openvibes-admin
Group=openvibes-admin
# After a plain `dnf upgrade` (board #77): additive migrations only; one
# that changes stored data fails this unit with "run Update", and the
# services then refuse the old schema as before.
ExecStart=/usr/bin/openvibes-admin migrate --additive
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
