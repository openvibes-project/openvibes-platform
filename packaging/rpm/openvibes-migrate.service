[Unit]
Description=OpenVIBES schema migrations after an upgrade, before the services start
Documentation=https://github.com/openvibes-project/openvibes-platform
After=postgresql.service
# Before Setup there is no database to migrate.
ConditionPathExists=/etc/openvibes/setup.toml

[Service]
Type=oneshot
User=openvibes-admin
Group=openvibes-admin
# A backup and a data migration can take a while; the services wait for it.
TimeoutStartSec=30min
# After a plain `dnf upgrade` (board #77): additive migrations as the
# service account. A migration that changes stored data (Update's case) makes the first line
# fail; the second, run with full privileges ("+"), then does Update's path:
# backup to /var/backups/openvibes, migrate, publish newer rules. It also
# repeats the additive attempt, so a current database costs nothing, and it
# fails the unit only when the migration really failed.
ExecStart=-/usr/bin/openvibes-admin migrate --additive
ExecStart=+/usr/bin/openvibes-admin helper upgrade-migrate
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
