#!/bin/bash
# At every start of the platform container (#604, #606, #607). The container
# comes installed: the first start sets the platform up from the compose
# file's settings (#635); every start after applies them again, changed ones
# included (#636), and puts the host back as Setup left it (Repair). A new
# image (#609) first backs up the database to the backups volume and
# migrates it. Then it says where the console is. The output goes to the
# container's log.
set -euo pipefail

# systemd starts its units with a clean environment; the compose file's
# settings are on PID 1. Only OPENVIBES_* is read, and nothing is evaluated.
declare -A setting
while IFS= read -r -d '' pair; do
    case $pair in OPENVIBES_*=*) setting[${pair%%=*}]=${pair#*=} ;; esac
done < /proc/1/environ
get() { printf '%s' "${setting[$1]-}"; }

stop() {
    echo "OpenVIBES is not set up: $*"
    echo "Fix it in the compose file or its .env, then run: docker compose up -d"
    exit 1
}

# The administrator's password, for Setup (and for Repair, when an earlier
# start stopped before the account was made). Only root reads it, and it is
# gone when this script ends.
password=$(get OPENVIBES_ADMIN_PASSWORD)
password_file=/run/openvibes-admin-password
trap 'rm -f "$password_file"' EXIT
if [ -n "$password" ]; then
    (umask 077; printf '%s\n' "$password" > "$password_file")
fi

# What the settings ask for, as Setup's plan arguments (without the CA,
# which is chosen once). On a bad setting, says which and returns 1.
wanted() {
    hostname=$(get OPENVIBES_HOSTNAME)
    if [ -z "$hostname" ]; then echo "OpenVIBES: OPENVIBES_HOSTNAME is empty."; return 1; fi
    # The appliance's components (as its Install picks), with no agent (the
    # container's host is not this one) and no assistant (its own container,
    # #644).
    components=ingest,console,distribution,vulns,rules,signer
    args=(--components "$components" --hostname "$hostname" --admin-password-file "$password_file")
    IFS=, read -ra names <<< "$(get OPENVIBES_EXTRA_NAMES)"
    for name in "${names[@]}"; do
        name=${name// /}
        [ -z "$name" ] || args+=(--san "$name")
    done
    for port in console ingest distribution; do
        value=$(get "OPENVIBES_${port^^}_PORT")
        [ -z "$value" ] || args+=("--$port-port" "$value")
    done
}

# The image's version, and the one the data was last started with (#609).
image=$(rpm -q --qf '%{VERSION}-%{RELEASE}' openvibes-admin)
seen_file=/etc/openvibes/container-image
backups=/var/backups/openvibes
keep_backups=3

# A new image on data from an older one: back up, then migrate, before
# Repair starts anything. Nothing else runs yet (a new container has no
# unit turned on). A failure stops here, with the way back.
update_from_image() {
    local from=$1 file line
    go_back() {
        echo "OpenVIBES: the update from $from to $image stopped: $*"
        echo "To go back, set OPENVIBES_IMAGE=ghcr.io/openvibes-project/openvibes-platform:${from%%-*} in .env, then run: docker compose up -d"
        exit 1
    }
    install -d -m 0700 "$backups"
    file=$backups/openvibes-${from%%-*}-$(date -u +%Y%m%d-%H%M%S).dump
    echo "OpenVIBES: updating from $from to $image: backing up the database first"
    line=$(openvibes-admin helper update-step backup --backup "$file" 2>&1) || true
    [[ $line == done$'\t'* ]] || go_back "the backup failed, nothing was changed: ${line#*$'\t'}"
    echo "OpenVIBES: the backup is $file on the backups volume"
    line=$(openvibes-admin helper update-step migrate 2>&1) || true
    [[ $line == done$'\t'* ]] || go_back "the database update failed and the database is as it was: ${line#*$'\t'}. The backup from before is $file on the backups volume."
    echo "OpenVIBES: database updated: ${line#*$'\t'}"
    # The newest few image-update backups stay; older ones (and their
    # roles files) go, so the volume does not fill up.
    ls -1t "$backups"/openvibes-*-*.dump 2>/dev/null | tail -n +$((keep_backups + 1)) | while IFS= read -r old; do
        rm -f -- "$old" "$old.roles.sql" || true
    done || true
}

plan=/etc/openvibes/setup.toml
if [ -e "$plan" ]; then
    seen=$(cat "$seen_file" 2>/dev/null || true)
    if [ -n "$seen" ] && [ "$seen" != "$image" ]; then
        update_from_image "$seen"
    fi
    # A later start (#636): the settings may have changed since. Save them as
    # the plan, as the appliance's Maintenance pages do, and Repair applies
    # them: new names get new certificates, moved ports move. A bad setting
    # keeps the plan from before, and the platform still comes back.
    before=$(cat "$plan")
    ca=$(sed -n 's/^ca = "\(.*\)"$/\1/p' <<< "$before")
    if ! { wanted && openvibes-admin helper setup-plan "${args[@]}" --ca "$ca" > /dev/null; }; then
        echo "OpenVIBES: kept the settings from before. Fix the compose file or its .env, then run: docker compose up -d"
    fi
    openvibes-admin setup --repair
    for port in ingest distribution; do
        from=$(sed -n "s/^${port}_port = //p" <<< "$before")
        to=$(sed -n "s/^${port}_port = //p" "$plan")
        if [ -n "$from" ] && [ "$from" != "$to" ]; then
            echo "OpenVIBES: the $port port moved from $from to $to; agents on other hosts still call $from until their install line from the console is run again."
        fi
    done
else
    wanted || stop "see above."
    # The console's rule (platform-password); checked here so a short one
    # stops before Setup changes anything.
    [ "${#password}" -ge 15 ] || stop "OPENVIBES_ADMIN_PASSWORD needs at least 15 characters."
    # A CA from your PKI: its certificate and key in one mounted file.
    # Without it, OpenVIBES makes one.
    ca_file=$(get OPENVIBES_CA_FILE)
    if [ -n "$ca_file" ]; then
        [ -r "$ca_file" ] || stop "OPENVIBES_CA_FILE: $ca_file is not mounted in the container."
        openvibes-admin helper ca-import < "$ca_file" || stop "the CA in $ca_file was refused (above)."
        args+=(--ca import)
    fi
    echo "OpenVIBES: setting up $hostname from the compose file"
    openvibes-admin setup --quick "${args[@]}" || stop "Setup failed (above)."
fi
# The data now matches this image.
printf '%s\n' "$image" > "$seen_file"

# The assistant is its own container (#643, #652): the platform makes the
# key the two share, on its first start, and points the console at the
# assistant on 127.0.0.1:18430 every start. Whether the assistant container
# runs decides whether the assistant is on (#644): the console shows none
# while it has never answered (#653).
shared=/var/lib/openvibes-assistant-key/llm-api-key
console_key=/etc/openvibes/llm-api-key
console_conf=/etc/openvibes/console.toml
if [ -d "${shared%/*}" ] && [ -f "$console_conf" ]; then
    restart=
    if [ ! -s "$shared" ]; then
        (umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$shared.new")
        chown 0:976 "$shared.new"
        chmod 0640 "$shared.new"
        mv "$shared.new" "$shared"
    fi
    # The console wants its own owner-only copy; the assistant reads the
    # shared one through its group.
    if ! cmp -s "$shared" "$console_key"; then
        install -o openvibes-console -g openvibes-console -m 0400 "$shared" "$console_key"
        restart=1
    fi
    alias=$(sed -n 's/^LLM_MODEL_ALIAS=//p' /usr/share/openvibes-llm/model.pin)
    if ! grep -q '^\[assistant' "$console_conf"; then
        cat >> "$console_conf" <<EOF

# The assistant container (early beta), written by the container's start.
[assistant]
enabled = true
profile = "small"
lookup_mode = "auto"

[assistant.backend]
url = "http://127.0.0.1:18430/v1"
model = "$alias"
api_key_file = "$console_key"
EOF
        restart=1
    elif grep -q '^url = "http://127.0.0.1:18430/v1"$' "$console_conf" \
        && ! grep -q "^model = \"$alias\"$" "$console_conf"; then
        # A new image pins another model.
        sed -i "/^\[assistant.backend\]/,/^\[/ s/^model = .*/model = \"$alias\"/" "$console_conf"
        restart=1
    fi
    if [ -n "$restart" ]; then systemctl try-restart openvibes-console; fi
fi

origin=$(sed -n 's/^public_origin = "\(.*\)"$/\1/p' /etc/openvibes/console.toml 2>/dev/null || true)
if [ -n "$origin" ]; then echo "OpenVIBES console: $origin"; fi
