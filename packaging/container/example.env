# Copy to .env next to compose.yaml and fill in; docker compose reads it.
# Keep .env private (chmod 600): it holds the administrator's password.

# The name agents and browsers use for this host.
OPENVIBES_HOSTNAME=openvibes.lan
# More names or IP addresses for it, comma-separated.
OPENVIBES_EXTRA_NAMES=

# The console's first administrator is "admin"; at least 15 characters.
OPENVIBES_ADMIN_PASSWORD=

# Ports (the same number is published on the host).
#OPENVIBES_CONSOLE_PORT=443
#OPENVIBES_INGEST_PORT=18423
#OPENVIBES_DISTRIBUTION_PORT=18424

# The assistant: on or off.
#OPENVIBES_ASSISTANT=off

# A CA from your PKI (certificate chain and key in one PEM file); mount it in
# compose.yaml. Without it, OpenVIBES makes its own.
#OPENVIBES_CA_FILE=/mnt/ca.pem
