    "@types/react-dom": "19.2.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
